    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.3.3",
    "@elysiajs/opentelemetry": "^1.3.1",
    "@elysiajs/swagger": "^1.3.1",
    "@prisma/adapter-pg": "^6.11.1",
    "@prisma/client": "^6.11.1",
    "elysia": "latest"
  },
  "devDependencies": {
    "bun-types": "latest",
    "prisma": "^6.11.1"
  },
  "module": "src/index.js"
}

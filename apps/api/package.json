{
  "name": "@yield-x/api",
  "version": "1.0.0",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "prisma generate && bun run --watch src/index.ts",
    "start:db": "prisma dev",
    "seed": "bun run src/scripts/seed.ts",

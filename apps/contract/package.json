{
  "name": "@yield-x/contract",
  "version": "1.0.0",
  "type": "module",
  "private": "true",
  "license": "ISC",
  "scripts": {
    "lint:fix": "prettier */*.js \"*/**/*{.js,.ts}\" -w",
    "lint": "prettier */*.js \"*/**/*{.js,.ts}\" --check",
    "test": "anchor test",
    "test:unit": "anchor test --skip-local-validator",
    "build": "anchor build",
    "deploy:localnet": "anchor deploy --provider.cluster localnet",
    "start:validator": "solana-test-validator --quiet &",
    "stop:validator": "pkill solana-test-validator"
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.31.1",
    "@solana/spl-token": "0.4.13",
    "@solana/web3.js": "1.98.2"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.0",
    "@types/chai": "^4.3.0",
    "@types/mocha": "^9.0.0",
    "chai": "^4.3.4",
    "mocha": "^9.0.3",
    "ts-mocha": "^10.0.0"
  }
}
